# Проверка GET/POST /api/v1/rooms.
# Фактические результаты 12.11.2026: ../docs/room-creation-verification.md.
# Предусловия и результаты ручной проверки приведены в отчёте.
# Каждый POST с корректными данными от Vera добавляет комнату.
@baseUrl = http://localhost:8080

### 1. Контроль GET на исходном seed (любой demo-user)
# Ожидается 200: Vega, Sirius; page=0, size=2, totalElements=3.
# Для этого запроса HTTP-результат за 12 ноября отдельно не зафиксирован.
GET {{baseUrl}}/api/v1/rooms?minCapacity=8&page=0&size=2
Accept: application/json

### 2. Создать комнату: запустить приложение с --app.demo-user=vera
# На исходном seed 4 комнаты. Ожидается 201, новый UUID, name="Atlas",
# capacity=6, hasProjector=false, description="".
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json
Accept: application/json

{
  "name": "  Atlas  ",
  "capacity": 6,
  "hasProjector": false,
  "description": ""
}

### 3. Проверить сохранение без перезапуска
# После ровно одного успешного POST: 200, totalElements=5;
# порядок Orion, Atlas, Vega, Sirius, Luna.
# id Atlas должен совпадать с ответом предыдущего POST.
GET {{baseUrl}}/api/v1/rooms
Accept: application/json

### 4. Имя из пробелов: Vera, тот же процесс
# Ожидается 400 с пустым телом, запись не добавляется.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{
  "name": "      ",
  "capacity": 6,
  "hasProjector": false,
  "description": ""
}

### 5. Нулевая вместимость: Vera, тот же процесс
# Ожидается 400 с пустым телом, запись не добавляется.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{
  "name": "  Atlas  ",
  "capacity": 0,
  "hasProjector": false,
  "description": ""
}

### 6. Пропущен hasProjector: Vera, тот же процесс
# Ожидается 400 с пустым телом, запись не добавляется.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{
  "name": "  Atlas  ",
  "capacity": 6,
  "description": ""
}

### 7. Явный null в hasProjector: Vera, тот же процесс
# Ожидается 400 с пустым телом, запись не добавляется.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{
  "name": "  Atlas  ",
  "capacity": 6,
  "hasProjector": null,
  "description": ""
}

### 8. Проверить состояние после четырёх отказов
# Тот же процесс Vera: 200, totalElements=5; та же Atlas с тем же UUID.
GET {{baseUrl}}/api/v1/rooms
Accept: application/json

### 9. Запрет для USER: остановить Vera и запустить --app.demo-user=anna
# Перезапуск сбрасывает память: исходных комнат снова 4.
# Тело корректное, но роль USER: ожидается 403 с пустым телом.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{
  "name": "  Atlas  ",
  "capacity": 6,
  "hasProjector": false,
  "description": ""
}

### 10. Проверить состояние после запрета для Anna
# Ожидается 200, totalElements=4: Orion, Vega, Sirius, Luna.
# Atlas отсутствует после сброса памяти; запрещённый POST ничего не добавил.
GET {{baseUrl}}/api/v1/rooms
Accept: application/json

# Проверка валидации тела запроса от 17.11.2026. Результаты в ../docs/request-validation-verification.md.

### Нулевая вместимость в отладчике
# Vera. Получен 400 со стандартным JSON Spring. Точка останова в POST-методе не сработала.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"  Atlas  ","capacity":0,"hasProjector":false}

### Корректный false и нормализация имени
# Vera, тот же запуск. Точка останова сработала. Получен 201: Atlas, 8, false, description=null.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"  Atlas  ","capacity":8,"hasProjector":false}

### Контроль списка комнат до и после отказов
# Перезапустить приложение от Vera после успешного POST. Выполнить этот GET до и после четырёх POST ниже.
# Оба раза получен 200 и те же четыре исходные комнаты, totalElements=4.
GET {{baseUrl}}/api/v1/rooms

### Пропущен hasProjector
# Получен 400 на валидации DTO.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":8}

### Явный null в hasProjector
# Получен 400 на валидации DTO.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":8,"hasProjector":null}

### Пробельное имя
# Получен 400 на валидации DTO.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"   ","capacity":8,"hasProjector":false}

### Нулевая вместимость в новом запуске Vera
# Получен 400 на валидации DTO. Повторить контрольный GET комнат.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":0,"hasProjector":false}

# Проверка параметров списка комнат от 17.11.2026. Результаты в ../docs/url-parameters-verification.md.
# Группа выполняется на исходных данных от Anna.

### Значения пагинации по умолчанию для комнат
# Получен 200: page=0, size=20, totalElements=4.
GET {{baseUrl}}/api/v1/rooms

### Пустой page для комнат
# Получен 400 со стандартным JSON Spring.
GET {{baseUrl}}/api/v1/rooms?page=

### Пустой size для комнат
# Получен 400 со стандартным JSON Spring.
GET {{baseUrl}}/api/v1/rooms?size=

### Page выходит за пределы int
# Получен 400 со стандартным JSON Spring.
GET {{baseUrl}}/api/v1/rooms?page=2147483648

### Минимальная вместимость 8
# Получен 200: Vega, Sirius, Luna, totalElements=3.
GET {{baseUrl}}/api/v1/rooms?minCapacity=8

### Пустой minCapacity
# Получен 400 со стандартным JSON Spring.
GET {{baseUrl}}/api/v1/rooms?minCapacity=

### Нулевой minCapacity
# Получен 400 со стандартным JSON Spring.
GET {{baseUrl}}/api/v1/rooms?minCapacity=0

# Десериализация JSON при создании комнат. Запуск от Vera.
# Результаты в ../docs/json-deserialization-verification.md.

### Неизвестное поле id при создании комнаты
# Получен 400 при десериализации.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":false,"id":"11111111-1111-1111-1111-111111111111"}

### Дробное число в capacity
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4.5,"hasProjector":false}

### Строка с цифрой в capacity
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":"4","hasProjector":false}

### Пустая строка в capacity
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":"","hasProjector":false}

### Строка в hasProjector
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":"false"}

### Число в hasProjector
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":0}

### Число в name
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":123,"capacity":4,"hasProjector":false}

### Логическое значение в description
# Получен 400.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":false,"description":true}

### Корректный false и пропущенное описание
# Получен 201, hasProjector=false и description=null.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":false}

### Корректный false и явный null в описании
# Получен 201, hasProjector=false и description=null.
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":false,"description":null}

### Чтение комнат после создания Atlas с description=null
# Получен 200. В свежем процессе после одного POST totalElements=5. У Orion и Atlas description=null, у Vega description="".
GET {{baseUrl}}/api/v1/rooms

### Пустая строка в необязательном описании
# Получен 201, description="".
POST {{baseUrl}}/api/v1/rooms
Content-Type: application/json

{"name":"Atlas","capacity":4,"hasProjector":false,"description":""}
